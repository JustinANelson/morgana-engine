    "onboarding": {
        "tips": [
            {
                "id": "welcome",
                "trigger": "WELCOME",
                "title": "Welcome to Ashen Keep",
                "text": "Open your bag ({key:INVENTORY}) to check your gear, or talk to the Keep residents with {key:INTERACT}: Commander Vael has contracts for the crypt, and Delve Warden Orin sets the dungeon difficulty. Step through the northern stone archway portal to begin a run!"
            },
            {
                "id": "combat",
                "trigger": "EQUIPMENT_FOUND",
                "title": "Action Combat",
                "text": "Left click attacks toward your cursor and chains into combos. Right click unleashes your heavy class skill, Space dodges with invulnerability frames, and holding Q guards. Watch for red ground telegraphs during Malakor's boss fight!"
            },
            {
                "id": "death",
                "trigger": "DEATH",
                "title": "Fallen in the Crypt",
                "text": "You are a ghost: you can move but not fight. A party mate can cast Rekindle on you to revive you on the spot. After 30 seconds you can type /revive to rise with 40% HP. If your whole party falls, the run ends and you wake in Ashen Keep."
            },
            {
                "id": "paragon",
                "trigger": "LEVEL",
                "level": 50,
                "title": "Paragon Levels",
                "text": "You reached the level cap! Experience now earns Paragon levels, each granting an attribute point."
            }
        ]
