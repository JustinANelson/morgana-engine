{
    "schemaVersion": 1,
    "engineApi": "1",
    "id": "white-river",
    "name": "White River Online",
    "description": "An original online RPG of the White River valley: grind and gather your way from the trade town of Calder's Ford through Millrace Fields and Heronreach Marsh to the contested ground of Chalk Hollow and the Paleback headwaters. Three classes, life skills (gathering, fishing, cooking, alchemy, smithing), a player market and seamless zones.",
    "tags": [
        "orpg",
        "mmorpg",
        "life-skills",
        "open-world",
        "pvp"
    ],
    "capabilities": [
        "damage",
        "heal",
        "inventory",
        "teleport",
        "status",
        "message",
        "visual",
        "projectile",
        "progression",
        "vital",
        "state"
    ],
    "attributes": [
        {
            "id": "str",
            "name": "Strength",
            "short": "STR",
            "base": 10,
            "floor": 1,
            "cap": null,
            "allocatable": true
        },
        {
            "id": "agi",
            "name": "Agility",
            "short": "AGI",
            "base": 10,
            "floor": 1,
            "cap": null,
            "allocatable": true
        },
        {
            "id": "int",
            "name": "Insight",
            "short": "INT",
            "base": 10,
            "floor": 1,
            "cap": null,
            "allocatable": true
        },
        {
            "id": "vit",
            "name": "Vitality",
            "short": "VIT",
            "base": 10,
            "floor": 1,
            "cap": null,
            "allocatable": true
        }
    ],
    "vitals": [
        {
            "id": "hp",
            "name": "Health",
            "short": "HP",
            "color": "#dc2626",
            "role": "life",
            "max": "max(15, 90 + level * 18 + vit * 12 + str * 2 + bonus)",
            "regen": {
                "everyTicks": 40,
                "amount": "max(1, vit / 4)"
            }
        },
        {
            "id": "mp",
            "name": "Mana",
            "short": "MP",
            "color": "#7c3aed",
            "role": null,
            "max": "max(0, 20 + level * 8 + int * 10 + bonus)",
            "regen": {
                "everyTicks": 40,
                "amount": "max(1, int / 4)"
            }
        },
        {
            "id": "sp",
            "name": "Stamina",
            "short": "SP",
            "color": "#eab308",
            "role": null,
            "max": "100 + agi * 2 + bonus",
            "regen": {
                "everyTicks": 10,
                "amount": "3 + agi / 10"
            }
        }
    ],
    "progression": {
        "maxLevel": 60,
        "xpTable": null,
        "xpExpr": "90 * level * level"
    },
    "combat": {
        "melee": "raw = a.str * 2 + weapon; mit = d.vit + armor / 2; base = max(1, raw - mit); crit ? max(2, (3 * base + 1) / 2) : base",
        "ranged": "raw = a.agi * 2 + weapon + ammo; mit = d.agi / 2 + d.vit / 2 + armor / 2; base = max(1, raw - mit); crit ? max(2, (3 * base + 1) / 2) : base",
        "spell": "raw = max(1, basePower + (scales ? a.int * 2 : 0)); heals ? raw : max(1, raw - d.int / 2 - d.vit / 4)",
        "critChanceBp": "clamp(300 + a.agi * 40, 300, 5000)",
        "dodgeChanceBp": "clamp((d.agi - a.agi) * 40, 0, 3500)",
        "module": "realtime",
        "defaultAttackSpeedTicks": 10,
        "defaultNpcRespawnTicks": 100,
