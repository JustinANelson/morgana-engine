node_modules/
dist/
build/
**/build/
.gradle/
.toolchain/
.jre/
local.properties
server-data/
server-data-*/
worlds/
packs/
# The runtime-data names above must not hide source packages with the same name (com.morgana.server.worlds).
!**/src/**/worlds/
!**/src/**/packs/
client-data/
coverage/
*.log
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.keystore
*.hprof
hs_err_pid*.log
# The admin panel token (see wiki/server/admin_panel.md) is a secret wherever the data folder is.
admin-token.txt

# IDE, Kotlin daemon, and OS files
.kotlin/
.idea/
*.iml
.DS_Store
Thumbs.db

# IDE (Eclipse) build output
bin/
# The SDK launcher templates live in a folder named bin/ on purpose.
!distribution/src/bin/

# Python bytecode from game tool scripts
__pycache__/

# Lossless master audio kept beside a game (large); the shipped OGGs in assets/music/ are converted from it
games/*/source-audio/

# Private / developer games kept locally outside the public engine repo
games/trevana-realms/
# Tests of the private game stay beside it, local only (the other games' tests in game-tests are public)
game-tests/src/test/kotlin/com/morgana/gametests/Trevana*.kt
game-tests/src/test/kotlin/com/morgana/gametests/Trevena*.kt
# The same for its art exporter, specs and trailer scripts
game-art/src/main/kotlin/com/morgana/gameart/export/Trevana*.kt
game-art/src/test/kotlin/com/morgana/gameart/export/Trevana*.kt
game-art/specs/trevana-world/
game-art/specs/trevana_*.json
smoke-test/trailer*.mjs
TREVANA_REALMS_DESIGN_AND_CONTENT.md
TREVANA_OPS.md

# Written by every content reload (see wiki/content/hot_reload.md)
**/.reload-status.json

# One-time login tickets (see wiki/server/dev_login.md), wherever the data folder is.
dev-tickets/
