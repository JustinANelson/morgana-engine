local.properties
server-data/
server-data-*/
worlds/
packs/
# The runtime-data names above must not hide source packages with the same name (com.morgana.server.worlds).
!**/src/**/worlds/
!**/src/**/packs/
client-data/
coverage/
*.log
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.keystore
