<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console logging for the server, the tools and the desktop client's embedded server. Without this file Logback logs
  everything at DEBUG (Netty alone prints dozens of lines at start). Override with -Dlogback.configurationFile=<file>,
  e.g. through MORGANA_JAVA_OPTS in the SDK launchers.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
